   "type": "title",
   "title": "How GPS Knows Where You Are",
   "subtitle": "Without tracking your device"
  }
 },
 {
  "scene": "s01",
  "start": 5.775,
  "text": "The Global Positioning System does not require your mobile phone to transmit any data.",
