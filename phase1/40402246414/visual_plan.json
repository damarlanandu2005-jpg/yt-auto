  "seconds": 4.77,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Civilian Precision",
   "value": "10 ns",
   "label": "Signal offset measurement limit"
  }
 },
 {
  "scene": "s04",
  "start": 90.771,
  "text": "Once your device calculates the distance to a satellite, it uses that data to narrow down where you could be.",
  "sentences": [
   "s04.01"
  ],
  "id": "v020",
  "end": 97.647,
  "seconds": 6.88,
  "scene_start": true,
  "kind": "card",
  "card": {
   "type": "title",
   "title": "Combining Distance Spheres",
   "subtitle": "Narrowing down position"
  }
 },
 {
  "scene": "s04",
  "start": 97.647,
  "text": "If you know you are a certain distance from a single satellite, you could be anywhere on a sphere surrounding it.",
