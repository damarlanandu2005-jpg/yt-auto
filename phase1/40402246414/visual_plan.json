    "Perfect sync"
   ]
  }
 },
 {
  "scene": "s07",
  "start": 202.877,
  "text": "So how does GPS know where you are without ever tracking you?",
  "sentences": [
   "s07.01"
  ],
  "id": "v041",
  "end": 206.874,
  "seconds": 4.0,
  "scene_start": true,
  "kind": "card",
