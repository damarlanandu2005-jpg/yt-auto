   ],
   "right_title": "Pseudo-range",
   "right_points": [
    "Includes clock error",
    "Calculated by device"
   ]
  }
 },
 {
  "scene": "s05",
  "start": 145.013,
  "text": "To solve for this extra unknown variable, your receiver must look at more than just three space vehicles.",
  "sentences": [
   "s05.05"
  ],
  "id": "v030",
  "end": 152.753,
  "seconds": 7.74,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "multiple GPS satellites",
  "photo_queries": [
   "satellite constellation",
   "spacecraft group"
  ],
  "card": {
   "type": "stat",
   "title": "Extra Variable",
   "value": "4 Satellites",
   "label": "Needed to solve clock offset"
  }
 },
 {
  "scene": "s06",
  "start": 152.753,
  "text": "Even with four satellites and good geometry, tiny invisible physics",
  "sentences": [
   "s06.01"
  ],
  "id": "v031",
  "end": 157.1793157894737,
  "seconds": 4.43,
  "scene_start": true,
  "kind": "card",
  "card": {
   "type": "title",
   "title": "The Power of Relativity",
   "subtitle": "Physics in orbit"
  }
 },
 {
  "scene": "s06",
  "start": 157.1793157894737,
  "text": "forces threaten to ruin the accuracy of your navigation.",
  "sentences": [
   "s06.01"
  ],
  "id": "v032",
  "end": 161.652,
  "seconds": 4.47,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "space physics",
  "photo_queries": [
