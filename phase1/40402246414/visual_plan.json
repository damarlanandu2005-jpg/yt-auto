   "title": "Daily Gain",
   "value": "38.6 µs",
   "unit": "microseconds",
   "left_title": "Time Drift",
   "right_title": "Per Day"
  }
 },
 {
  "scene": "s06",
  "start": 187.116,
  "text": "Without corrections, errors of roughly 11.4 km per day would accumulate in the position.",
  "sentences": [
   "s06.07"
  ],
  "id": "v038",
  "end": 193.981,
  "seconds": 6.86,
  "scene_start": false,
  "kind": "card",
  "card": {
