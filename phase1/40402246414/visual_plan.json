   "value": "Precision",
   "label": "Measuring signal offset"
  }
 },
 {
  "scene": "s03",
  "start": 86.00200000000001,
  "text": "within about 10 nanoseconds for the civilian code.",
  "sentences": [
   "s03.07"
  ],
