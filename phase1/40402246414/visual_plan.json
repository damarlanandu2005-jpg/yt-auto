   "satellite in space",
   "orbiting satellite"
  ],
  "card": {
   "type": "stat",
   "title": "Satellite Altitude",
   "value": "High Orbit",
   "label": "Satellites far above Earth"
  }
 },
 {
  "scene": "s06",
  "start": 173.14428571428573,
  "text": "run faster by about 45,850 nanoseconds per day due to gravity.",
  "sentences": [
   "s06.05"
  ],
  "id": "v035",
  "end": 178.677,
  "seconds": 5.53,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Gravity Effect",
   "value": "45,850 ns",
   "unit": "ns/day",
   "left_title": "Relativity",
   "right_title": "Clock Speed"
  }
 },
 {
  "scene": "s06",
  "start": 178.677,
  "text": "Combined, these relativistic effects cause satellite clocks to",
  "sentences": [
   "s06.06"
  ],
  "id": "v036",
  "end": 182.91593333333333,
  "seconds": 4.24,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "bullets",
   "title": "Combined Relativistic Effects",
   "items": [
    "Gravity makes clocks run faster",
    "Speed makes clocks run slower",
    "Both effects combined"
   ]
  }
 },
 {
  "scene": "s06",
  "start": 182.91593333333333,
  "text": "gain about 38.6 microseconds every single day.",
  "sentences": [
   "s06.06"
  ],
  "id": "v037",
  "end": 187.116,
  "seconds": 4.2,
  "scene_start": false,
  "kind": "card",
  "card": {
