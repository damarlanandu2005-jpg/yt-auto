  "card": {
   "type": "stat",
   "title": "Third Satellite",
   "value": "2 Points",
   "label": "Shrinks intersection to two points"
  }
 },
 {
  "scene": "s04",
  "start": 117.834,
  "text": "One of those two points is usually out in space, leaving only a single realistic position on the Earth.",
