   "pocket watch"
  ],
  "card": {
   "type": "stat",
   "title": "Clock Offset",
   "value": "Time Error",
   "label": "Receiver clock vs satellite clock"
  }
 },
 {
  "scene": "s05",
  "start": 138.024,
  "text": "Because of this offset, your device cannot",
  "sentences": [
   "s05.04"
  ],
  "id": "v028",
  "end": 141.292,
  "seconds": 3.27,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "bullets",
