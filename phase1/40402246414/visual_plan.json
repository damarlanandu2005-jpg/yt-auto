    "Drifts from true time",
    "Causes range errors"
   ]
  }
 },
 {
  "scene": "s05",
  "start": 141.292,
  "text": "measure true ranges and instead calculates pseudo-ranges.",
  "sentences": [
   "s05.04"
  ],
  "id": "v029",
  "end": 145.013,
  "seconds": 3.72,
  "scene_start": false,
  "kind": "card",
