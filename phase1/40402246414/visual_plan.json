 },
 {
  "scene": "s03",
  "start": 70.621,
  "text": "How do those radio waves turn into a measurement of distance on your device?",
  "sentences": [
   "s03.01"
  ],
  "id": "v015",
  "end": 75.474,
  "seconds": 4.85,
  "scene_start": true,
  "kind": "card",
  "card": {
   "type": "title",
   "title": "Measuring Signal Speed",
   "subtitle": "Converting time to distance"
  }
 },
 {
  "scene": "s03",
  "start": 75.474,
  "text": "The time delay between when a satellite transmits a signal",
  "sentences": [
   "s03.05"
  ],
  "id": "v016",
  "end": 78.70971428571428,
  "seconds": 3.24,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "flow",
   "title": "Time Delay",
   "steps": [
    "Satellite transmits",
    "Signal travels",
    "Receiver gets signal"
   ]
  }
 },
 {
  "scene": "s03",
  "start": 78.70971428571428,
  "text": "and when a receiver gets it is proportional to the distance.",
  "sentences": [
   "s03.05"
  ],
  "id": "v017",
  "end": 82.72,
  "seconds": 4.01,
  "scene_start": false,
  "kind": "photo",
