  "card": {
   "type": "stat",
   "title": "Single Satellite",
   "value": "1 Sphere",
   "label": "You could be anywhere on the sphere"
  }
 },
 {
  "scene": "s04",
  "start": 103.986,
  "text": "Adding a second satellite narrows your possible location",
  "sentences": [
   "s04.04"
  ],
  "id": "v022",
