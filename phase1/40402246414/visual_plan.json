  ],
  "card": {
   "type": "stat",
   "title": "Final Position",
   "value": "1 Position",
   "label": "One point on Earth surface"
  }
 },
 {
  "scene": "s05",
  "start": 125.81,
  "text": "There is a major catch in this simple geometry that requires an extra step from your receiver.",
  "sentences": [
   "s05.01"
  ],
  "id": "v026",
  "end": 131.966,
  "seconds": 6.16,
  "scene_start": true,
  "kind": "card",
  "card": {
   "type": "title",
   "title": "Correcting Clock Errors",
   "subtitle": "The fourth dimension"
  }
 },
 {
  "scene": "s05",
  "start": 131.966,
  "text": "That cheap clock has a time offset relative to the true time kept by the satellite network.",
  "sentences": [
   "s05.03"
  ],
  "id": "v027",
  "end": 138.024,
  "seconds": 6.06,
  "scene_start": false,
