   "value": "2 Spheres",
   "label": "Narrows position to an intersecting circle"
  }
 },
 {
  "scene": "s04",
  "start": 107.345,
  "text": "down to the circle where two spheres intersect.",
  "sentences": [
   "s04.04"
  ],
  "id": "v023",
  "end": 111.182,
  "seconds": 3.84,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
