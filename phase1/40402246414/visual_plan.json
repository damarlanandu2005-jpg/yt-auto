   "relativity concept"
  ],
  "card": {
   "type": "stat",
   "title": "Accuracy Threat",
   "value": "Relativity",
   "label": "Tiny invisible physics forces"
  }
 },
 {
  "scene": "s06",
  "start": 161.652,
  "text": "General relativity also shows that clocks located deeper in a gravitational well tick slower.",
  "sentences": [
   "s06.04"
  ],
  "id": "v033",
  "end": 168.55,
  "seconds": 6.9,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "gravitational field diagram",
  "photo_queries": [
   "gravity well",
   "spacetime curvature"
  ],
  "card": {
   "type": "stat",
   "title": "Gravity Well",
   "value": "Slower Ticks",
   "label": "Clocks deeper in gravity tick slower"
  }
 },
 {
  "scene": "s06",
  "start": 168.55,
  "text": "Because the satellites are far above the Earth, their clocks",
  "sentences": [
   "s06.05"
  ],
  "id": "v034",
  "end": 173.14428571428573,
  "seconds": 4.59,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "a GPS satellite",
