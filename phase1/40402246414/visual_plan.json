   "value": "Circle",
   "label": "Where two spheres meet"
  }
 },
 {
  "scene": "s04",
  "start": 111.182,
  "text": "Bringing in a third satellite shrinks the intersection down to just two points in three-dimensional space.",
  "sentences": [
   "s04.05"
  ],
  "id": "v024",
  "end": 117.834,
  "seconds": 6.65,
  "scene_start": false,
  "kind": "photo",
