   "radio wave",
   "signal propagation"
  ],
  "card": {
   "type": "stat",
   "title": "Distance",
   "value": "Proportional",
   "label": "Time delay equals distance"
  }
 },
 {
  "scene": "s03",
  "start": 82.72,
  "text": "Modern electronics can measure this signal offset to",
  "sentences": [
   "s03.07"
  ],
  "id": "v018",
  "end": 86.00200000000001,
  "seconds": 3.28,
  "scene_start": false,
