  "card": {
   "type": "title",
   "title": "Two Satellites",
   "subtitle": "Intersection Forms a Circular Ring"
  }
 },
 {
  "scene": "s03",
  "start": 155.253,
  "text": "Taking several distance measurements allows a receiver to find the point where the spherical shells meet.",
  "sentences": [
   "s03.06"
  ],
  "id": "v033",
  "end": 161.643,
  "seconds": 6.39,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "a 3D geometric intersection model",
