   "3d geometry"
  ],
  "card": {
   "type": "title",
   "title": "Sphere Intersection",
   "subtitle": "Narrowing Down Location Points"
  }
 },
 {
  "scene": "s03",
  "start": 161.643,
  "text": "Your receiver generates a position fix by finding where multiple spherical shells meet.",
  "sentences": [
   "s03.07"
  ],
