   "precision timer"
  ],
  "card": {
   "type": "title",
   "title": "Transmission Timestamp",
   "subtitle": "Exact Time Signal Left Satellite"
  }
 },
 {
  "scene": "s02",
  "start": 107.526,
  "text": "When your device receives the signal, it records the arrival time using its own internal clock.",
  "sentences": [
   "s02.07"
  ],
  "id": "v024",
  "end": 114.206,
  "seconds": 6.68,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "a computer microchip processor",
  "photo_queries": [
   "microchip",
   "clock crystal"
  ],
  "card": {
   "type": "title",
   "title": "Arrival Timestamp",
   "subtitle": "Recorded by Internal Device Clock"
  }
 },
 {
  "scene": "s02",
  "start": 114.206,
  "text": "By subtracting the transmission time from the arrival time, the receiver calculates the signal delay.",
  "sentences": [
   "s02.08"
  ],
  "id": "v025",
  "end": 120.701,
  "seconds": 6.49,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "flow",
   "title": "Calculating Signal Delay",
   "steps": [
    "Arrival Time",
    "Subtract Transmission Time",
    "Signal Transit Delay"
   ]
  }
 },
 {
  "scene": "s02",
  "start": 120.701,
  "text": "Multiplying this time value by the speed of light yields a pseudorange rather than an exact distance.",
  "sentences": [
   "s02.09"
  ],
  "id": "v026",
  "end": 127.503,
  "seconds": 6.8,
  "scene_start": false,
  "kind": "photo",
