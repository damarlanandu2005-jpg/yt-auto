   "orbiting satellites"
  ],
  "card": {
   "type": "title",
   "title": "Multiple Signals",
   "subtitle": "Combining Satellites for Precise Location"
  }
 },
 {
  "scene": "s03",
  "start": 149.874,
  "text": "When you receive a distance measurement from a second satellite, a second sphere is created.",
  "sentences": [
   "s03.05"
  ],
  "id": "v032",
  "end": 155.253,
  "seconds": 5.38,
  "scene_start": false,
  "kind": "photo",
