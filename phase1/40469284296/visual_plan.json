   "subtitle": "Position Lies on a Spherical Shell"
  }
 },
 {
  "scene": "s03",
  "start": 143.614,
  "text": "To narrow down your location, your phone needs signals from additional satellites orbiting above.",
  "sentences": [
   "s03.03"
  ],
  "id": "v031",
  "end": 149.874,
  "seconds": 6.26,
  "scene_start": false,
