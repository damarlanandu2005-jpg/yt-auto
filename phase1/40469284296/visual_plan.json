   "math formula",
   "physics calculation"
  ],
  "card": {
   "type": "title",
   "title": "Pseudorange Formula",
   "subtitle": "Delay x Speed of Light = Distance"
  }
 },
 {
  "scene": "s02",
  "start": 127.503,
  "text": "Because light moves so fast, a tiny timing offset of",
  "sentences": [
   "s02.11"
  ],
  "id": "v027",
  "end": 131.4266842105263,
  "seconds": 3.92,
  "scene_start": false,
