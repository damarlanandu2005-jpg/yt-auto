  ],
  "card": {
   "type": "stat",
   "title": "Signal Speed",
   "value": "299,792 km/s",
   "label": "Speed of Light in Vacuum"
  }
 },
 {
  "scene": "s02",
  "start": 86.781,
  "text": "Crucially, the speed of radio waves is constant and completely independent of the satellite's speed.",
  "sentences": [
   "s02.04"
  ],
