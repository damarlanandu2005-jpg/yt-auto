  }
 },
 {
  "scene": "s02",
  "start": 93.462,
  "text": "Each satellite continually broadcasts a pseudorandom sequence of",
  "sentences": [
   "s02.05"
  ],
  "id": "v021",
  "end": 97.12813333333334,
  "seconds": 3.67,
  "scene_start": false,
