  "seconds": 6.45,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Third Satellite",
   "value": "3rd Surface",
   "label": "Third spherical surface",
   "note": "Broadcasting source"
  }
 },
 {
  "scene": "s03",
  "start": 174.136,
  "text": "Combining multiple distance measurements allows the receiver to determine the point where the shells meet.",
  "sentences": [
