   "subtitle": ""
  }
 },
 {
  "scene": "s02",
  "start": 100.948,
  "text": "The transmission message includes a timestamp recording the exact time the signal left the satellite.",
  "sentences": [
   "s02.06"
  ],
  "id": "v023",
  "end": 107.824,
  "seconds": 6.88,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Timestamp",
   "value": "Exact Time",
   "label": "Signal departure time",
   "note": "Included in transmission"
  }
 },
 {
  "scene": "s02",
  "start": 107.824,
  "text": "When your device receives the signal, it records the arrival time using its own internal clock.",
  "sentences": [
   "s02.07"
  ],
  "id": "v024",
  "end": 114.526,
  "seconds": 6.7,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "an internal clock circuit",
  "photo_queries": [
   "quartz clock",
   "internal clock"
  ],
  "card": {
   "type": "stat",
   "title": "Arrival Time",
   "value": "Internal Clock",
   "label": "Receiver timestamp",
   "note": "Recorded on receipt"
  }
 },
 {
  "scene": "s02",
  "start": 114.526,
  "text": "By subtracting the transmission time from the arrival time, the receiver calculates the signal delay.",
  "sentences": [
   "s02.08"
  ],
  "id": "v025",
  "end": 120.978,
  "seconds": 6.45,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "flow",
   "title": "Delay Calculation",
   "steps": [
    "Arrival time",
    "Minus transmission time",
    "Equals signal delay"
   ]
  }
 },
 {
  "scene": "s02",
  "start": 120.978,
  "text": "Multiplying this time value by the speed of light yields a pseudorange rather than an exact distance.",
  "sentences": [
   "s02.09"
  ],
  "id": "v026",
  "end": 127.781,
  "seconds": 6.8,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Pseudorange",
   "value": "Time x Light",
   "label": "Calculated measurement",
   "note": "Rather than exact distance"
  }
 },
 {
  "scene": "s02",
  "start": 127.781,
  "text": "Because light moves so fast, a tiny timing offset of",
  "sentences": [
   "s02.11"
  ],
  "id": "v027",
  "end": 131.71363157894737,
  "seconds": 3.93,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Timing Sensitivity",
   "value": "Very fast",
   "label": "Light speed movement",
   "note": "Tiny offsets matter"
  }
 },
 {
  "scene": "s02",
  "start": 131.71363157894737,
  "text": "just 10 nanoseconds causes a 3 metre distance error.",
  "sentences": [
   "s02.11"
  ],
  "id": "v028",
  "end": 136.726,
  "seconds": 5.01,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Distance Error",
   "value": "3 metres",
   "label": "Caused by timing offset",
   "note": "10 nanoseconds offset"
  }
 },
 {
