 },
 {
  "scene": "s02",
  "start": 80.397,
  "text": "Radio signals broadcast from these satellites travel through space at the constant speed of light.",
  "sentences": [
   "s02.03"
  ],
  "id": "v019",
  "end": 86.845,
  "seconds": 6.45,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Signal Speed",
   "value": "Speed of light",
   "label": "Radio wave velocity",
   "note": "Traveling through space"
  }
 },
 {
  "scene": "s02",
  "start": 86.845,
  "text": "Crucially, the speed of radio waves is constant and completely independent of the satellite's speed.",
  "sentences": [
   "s02.04"
  ],
