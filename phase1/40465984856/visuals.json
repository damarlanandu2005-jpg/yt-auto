   "value": "Independent",
   "label": "Of satellite speed",
   "note": "Speed of light is constant"
  }
 },
 {
  "scene": "s02",
  "start": 93.525,
  "text": "Each satellite continually broadcasts a pseudorandom sequence of",
  "sentences": [
   "s02.05"
  ],
  "id": "v021",
