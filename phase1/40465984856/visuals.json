  "card": {
   "type": "stat",
   "title": "Location Reduction",
   "value": "Extra Signals",
   "label": "Required from above",
   "note": "Narrowing location"
  }
 },
 {
  "scene": "s03",
  "start": 150.044,
  "text": "When you receive a distance measurement from a second satellite, a second sphere is created.",
  "sentences": [
   "s03.05"
  ],
  "id": "v032",
  "end": 155.466,
  "seconds": 5.42,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "title",
   "title": "Second Satellite",
   "subtitle": ""
  }
 },
 {
  "scene": "s03",
  "start": 155.466,
  "text": "Taking several distance measurements allows a receiver to find the point where the spherical shells meet.",
  "sentences": [
   "s03.06"
  ],
  "id": "v033",
  "end": 161.832,
  "seconds": 6.37,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "flow",
   "title": "Intersection Process",
   "steps": [
    "Distance measurements",
    "Find meeting points",
    "Determine position"
   ]
  }
 },
 {
  "scene": "s03",
  "start": 161.832,
  "text": "Your receiver generates a position fix by finding where multiple spherical shells meet.",
  "sentences": [
   "s03.07"
  ],
  "id": "v034",
  "end": 167.683,
  "seconds": 5.85,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
   "title": "Position Fix",
   "value": "Spherical Shells",
   "label": "Where surfaces meet",
   "note": "Receiver calculation"
  }
 },
 {
  "scene": "s03",
  "start": 167.683,
  "text": "Adding a third satellite creates a third spherical surface around that third broadcasting source.",
