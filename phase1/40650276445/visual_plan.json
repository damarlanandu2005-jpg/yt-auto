  "id": "v028",
  "end": 151.019,
  "seconds": 6.13,
  "scene_start": false,
  "kind": "photo",
  "photo_subject": "a scientific telescope",
  "photo_queries": [
   "astronomical telescope",
   "observatory dome"
  ],
  "card": {
   "type": "title",
   "title": "Cosmic Scale Factor"
  }
 },
 {
  "scene": "s03",
  "start": 151.019,
  "text": "The scale factor grows over time, describing how physical distances expand across the universe.",
  "sentences": [
   "s03.03"
  ],
  "id": "v029",
  "end": 157.867,
  "seconds": 6.85,
  "scene_start": false,
  "kind": "drawing",
  "drawing_subject": "a grid expanding larger and larger in sequential steps",
  "card": {
   "type": "title",
   "title": "Growth Over Time"
  }
 },
 {
  "scene": "s03",
  "start": 157.867,
  "text": "In the early history of the universe, the scale factor was extremely small.",
  "sentences": [
   "s03.04"
  ],
  "id": "v030",
  "end": 162.816,
  "seconds": 4.95,
  "scene_start": false,
  "kind": "drawing",
  "drawing_subject": "a tiny dense sphere of hot glowing plasma",
  "card": {
   "type": "title",
   "title": "Early Universe"
  }
 },
 {
  "scene": "s03",
  "start": 162.816,
  "text": "That means all matter in the young cosmos was squeezed much closer together.",
  "sentences": [
   "s03.05"
  ],
  "id": "v031",
  "end": 167.613,
  "seconds": 4.8,
  "scene_start": false,
  "kind": "drawing",
  "drawing_subject": "packed glowing particles compressed tightly together",
  "card": {
   "type": "title",
   "title": "Matter Squeezed Together"
  }
 },
 {
  "scene": "s03",
  "start": 167.613,
  "text": "Before recombination, the universe was filled with an opaque white-hot fog of plasma.",
  "sentences": [
   "s03.07"
  ],
  "id": "v032",
  "end": 173.47,
  "seconds": 5.86,
  "scene_start": false,
  "kind": "photo",
