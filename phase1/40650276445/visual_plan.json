  "id": "v052",
  "end": 281.781,
  "seconds": 6.09,
  "scene_start": false,
  "kind": "drawing",
  "drawing_subject": "a clock multiplying by the speed of light",
  "card": {
   "type": "title",
   "title": "Light-Travel Distance Formula"
  }
 },
 {
  "scene": "s05",
  "start": 281.781,
  "text": "That calculation yields a light-travel distance of about 13.8 billion light-years.",
  "sentences": [
