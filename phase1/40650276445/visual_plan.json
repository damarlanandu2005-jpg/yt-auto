  "card": {
   "type": "title",
   "title": "White-Hot Plasma Fog"
  }
 },
 {
  "scene": "s03",
  "start": 173.47,
  "text": "Once neutral atoms formed, ancient photons became free to travel freely through transparent space.",
  "sentences": [
   "s03.08"
  ],
