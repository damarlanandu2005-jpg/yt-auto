   "title": "Cosmic Microwave Background"
  }
 },
 {
  "scene": "s03",
  "start": 187.345,
  "text": "When this ancient light was first emitted, its source was only 42 million light-years from Earth.",
  "sentences": [
   "s03.10"
  ],
  "id": "v035",
  "end": 193.652,
  "seconds": 6.31,
  "scene_start": false,
  "kind": "card",
  "card": {
   "type": "stat",
