   "title": "Distance Types",
   "left_title": "Light-Travel",
   "left_points": [
    "Based on travel time"
   ],
   "right_title": "Proper Distance",
   "right_points": [
    "Actual space gap"
   ]
  }
 },
 {
  "scene": "s05",
  "start": 275.688,
  "text": "Light-travel distance is simply the age of the universe multiplied by the speed of light.",
  "sentences": [
   "s05.04"
