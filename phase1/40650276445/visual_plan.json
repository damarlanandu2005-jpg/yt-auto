  "card": {
   "type": "title",
   "title": "Local Speed of Light"
  }
 },
 {
  "scene": "s04",
  "start": 223.863,
  "text": "A local comoving observer will always measure the speed of light as the standard constant speed.",
  "sentences": [
   "s04.05"
  ],
  "id": "v042",
  "end": 230.021,
  "seconds": 6.16,
  "scene_start": false,
  "kind": "photo",
