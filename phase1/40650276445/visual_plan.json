  "kind": "card",
  "card": {
   "type": "title",
   "title": "How 13.8 Billion Light-Years Turns Into a 46.5 Billion Light-Year Radius"
  }
 },
 {
  "scene": "s05",
  "start": 269.908,
  "text": "To understand this, we must distinguish between light-travel distance and proper distance.",
  "sentences": [
   "s05.03"
  ],
  "id": "v051",
  "end": 275.688,
  "seconds": 5.78,
  "scene_start": false,
  "kind": "card",
  "card": {
